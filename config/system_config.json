{
    "mqtt": {
        "host": "localhost",
        "port": 1883,
        "keep_alive": 60,
        "refresh_interval": 60
    },
    "redis": {
        "host": "localhost",
        "port": 6379
    },
    "zones": [
        {
            "sensor_path": "/home/sensors/bedroom",
            "name": "Bedrooms",
            "system": "hydronic",
            "outputs": [
                {"type": "gpio", "pin": "P8_10", "end_switch": "P8_9"},
                {"type": "gpio", "pin": "P8_14", "end_switch": "P8_17"}
            ],
            "pid_interval": 10,
            "control_interval": 10,
            "active_low": true
        },
        {
            "sensor_path": "/home/sensors/living_room",
            "name": "Common",
            "system": "hydronic",
            "outputs": [
                {"type": "gpio", "pin": "P8_8", "end_switch": "P8_15"}
            ],
            "pid_interval": 10,
            "control_interval": 10,
            "active_low": true
        },
        {
            "sensor_path": "/home/sensors/front_room",
            "name": "Study",
            "system": "hydronic",
            "pid": {"kp": 1, "ki": 0.001, "kd": 0, "integral_cap": 0.3},
            "outputs": [
                {"type": "gpio", "pin": "P8_12", "end_switch": "P8_11"}
            ],
            "pid_interval": 10,
            "control_interval": 10,
            "active_low": true
        },
        {
            "sensor_path": "/home/sensors/kitchen",
            "name": "Kitchen",
            "system": "hydronic",
            "outputs": [
                {"type": "gpio", "pin": "P8_16", "end_switch": "P8_7"}
            ],
            "pid_interval": 10,
            "control_interval": 10,
            "active_low": true
        },
        {
            "sensor_path": "/home/sensors/back_room",
            "name": "BackRoom",
            "system": "hydronic",
            "outputs": [
                {"type": "gpio", "pin": "P8_28", "end_switch": "P8_27"}
            ],
            "pid_interval": 10,
            "control_interval": 10,
            "active_low": true
        },
        {
            "sensor_path": "/home/sensors/stairwell",
            "name": "Stairwell",
            "system": "electric",
            "outputs": [
                {"type": "MQTTRelay", "topic": "cmnd/tasmota_E3738F/ZbSend", "device": "0xB5EA"}
            ],
            "pid_interval": 10,
            "control_interval": 10
        }
    ],
    "pid": {"kp": 1, "ki": 0.01, "kd": 0.5, "integral_cap": 1.0},
    "boiler": {
        "output_gpio": "P8_18",
        "poll_interval": 5
    },
    "shadow": {
        "pid": {"kp": 1, "ki": 0.001, "kd": 0, "integral_cap": 0.3}
    }
}
