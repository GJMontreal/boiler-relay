[Unit]
Description=Heating Zone and Boiler Control

[Service]
After=redis.service
Type=simple
User=heating
WorkingDirectory=/var/lib/boiler_relay
ExecStart=/home/heating/boiler_relay/.venv/bin/python /home/heating/boiler_relay/boiler_relay.py
Restart=on-failure
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
