[Unit]
Description=Heating Zone and Boiler Control (shadow)
After=redis.service
Conflicts=<service_name>.service

[Service]
Type=simple
User=<service_user>
WorkingDirectory=/var/lib/<service_name>
ExecStart=/var/lib/<service_name>/.venv/bin/python -m boiler_relay --shadow
Restart=on-failure
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/var/lib/<service_name>
