[Unit]
Description=Heating Zone and Boiler Control

[Service]
After=redis.service
Type=simple
User=<service_user>
WorkingDirectory=/var/lib/<project_name>
ExecStart=/var/lib/<project_name>/.venv/bin/python -m boiler_relay
Restart=on-failure
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/var/lib/<project_name>

[Install]
WantedBy=multi-user.target
